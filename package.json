{
  "name": "claude-code-infinite",
  "version": "1.0.38",
  "description": "Wrapper for Claude Code CLI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ccc": "dist/cli.js"
  },
  "type": "module",
  "files": [
    "dist",
    "postinstall.cmd"
  ],
  "scripts": {
    "build": "tsc && node scripts/chmod-cli.mjs",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "postinstall": "(\"./postinstall.cmd\")",
    "test": "npm run build && node scripts/run-tests.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude",
    "cli",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crizCraig/claude-code-infinite.git"
  },
  "author": "crizCraig",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.3"
  },
  "dependencies": {
    "cross-spawn": "7.0.6"
  }
}
